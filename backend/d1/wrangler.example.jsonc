  "main": "./worker.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "d1_databases": [{
    "binding": "ORIGIN_EDITORIAL_DB",
    "database_name": "origin-editorial-v1",
    "database_id": "REPLACE_WITH_VERIFIED_ORIGIN_D1_DATABASE_ID"
