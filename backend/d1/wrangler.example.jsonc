  "vars": {
    "ORIGIN_STUDIO_ALLOWED_ORIGIN": "https://origin-creator-journey.rayadinaveen98.workers.dev"
    // ORIGIN_ACCESS_TEAM_DOMAIN and ORIGIN_ACCESS_AUD must be set to real Access app values
